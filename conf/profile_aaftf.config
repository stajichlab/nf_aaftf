/*
 * Per-pipeline profile: AAFTF assembly framework (SPAdes short-read + polishing).
 *
 * Owns: this pipeline's params, per-process resources, workDir, and
 * trace/report/timeline so it never collides with other pipelines.
 *
 * Partitions (verify with `sinfo`):
 *   epyc (default,30d) | stajichlab (lab,30d) | short (≤2h) | highmem (30d)
 *
 * Container-only design:
 *   - singularity enabled here; every process carries `container` via withLabel
 *     'aaftf' (TRUE) or 'aaftf_lite' (vector-screening / light steps).
 *   - The AAFTF image hardcodes AAFTF_DB=/opt/aaaftf_db, so the host reference
 *     DB is bind-mounted there: singularity.runOptions below. The FCS-GX
 *     database (optional fcs-gx step) is separate and staged into /dev/shm by
 *     the FCS_GX process itself; it also needs extra binds (see runOptions).
 *   - `shell = ['/bin/bash']` (NOT -l): login shell resets PATH on this cluster
 *     and hides the image's pixi env where `AAFTF` lives.
 */

params {
    // ── Inputs / outputs ────────────────────────────────────────────
    indir  = "${launchDir}/input"
    outdir = "${launchDir}/results"
    samples = "${launchDir}/samples.csv"
    n_test  = 0

    // ── Container + reference databases ─────────────────────────────
    // One pipeline, two engines. Set container_engine to pick which one:
    //   'singularity' (default) -> uses the cached AAFTF.sif (params.aaftf_sif)
    //   'docker'               -> uses the Docker Hub image (docker://params.aaftf_docker)
    // Both refer to the SAME AAFTF build (ghcr.io/stajichlab/aaftf:latest). The
    // SIF was pulled from that Docker image and cached as AAFTF.sif.
    container_engine = 'singularity'          // 'singularity' | 'docker'
    aaftf_sif        = "/bigdata/stajichlab/shared/lib/singularity_cache/AAFTF.sif"
    aaftf_docker     = "ghcr.io/stajichlab/aaftf:latest"
    aaftf_db         = "/bigdata/stajichlab/shared/lib/AAFTF_DB"   // host, bound to /opt/aaaftf_db
    taxondb          = "/srv/projects/db/taxonomy"                  // host NCBI taxdump for taxonkit (FCS_GX phylum resolution)
    fcsgx_db         = "/srv/projects/db/ncbi-fcs/0.5.4/gxdb"       // FCS-GX db (host path)
    fcsgx_tmp        = "/dev/shm/gxdb"                              // staged copy seen by the tools

    // ── Pipeline control ────────────────────────────────────────────
    fcs_taxid        = 4751               // fallback NCBI taxonomy id for FCS-GX purge (4751 = Fungi); per-sample override via samples.csv taxid column
    assembler      = 'spades'     // spades | megahit | unicycler (only spades ships in the image)
    polisher       = 'polca'      // polca | pilon | racon | nextpolish
    skip_fcsgx     = true         // FCS-GX purge is OPTIONAL (big download, big mem)
    skip_vecscreen = false        // VecScreen (AAFTF vecscreen) on assembled contigs

    // ── Trim / filter best practices ────────────────────────────────
    // AAFTF trim is run twice: fastp (dedup + merge + cutright quality trim)
    // then bbduk for a second adapter/quality pass with the same golden
    // parameters AAFTF ships. This mirrors JGI-style BBDuk-first QC thinking
    // while staying inside AAFTF's wrapper.
    dedup      = true
    minlen     = 75
    PHRED      = 20              // fastp --cut_right quality cutoff (via avgqual)
    trim_memory = 8              // GB for bbduk -Xmx (trim pass)
    trim_method1 = 'fastp'       // first trim pass
    trim_method2 = 'bbduk'       // second trim pass
    filter_aligner = 'bbduk'     // read filter aligner: bbduk | bowtie2 | bwa | minimap2

    // ── Assembly / polishing / finish ───────────────────────────────
    spades_memory = 64            // GB for SPAdes
    polisher_iterations = 1       // AAFTF polish --iterations (polca ignores)
    min_contig_len = 2000         // AAFTF sort/rmdup min contig length
    run_depth    = true           // AAFTF depth (needs reads back-mapped)
}

workDir = "${launchDir}/work/aaftf"

// ── Container engine: enabled + binds the reference DB into the image ───────
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
    // Bind the host AAFTF reference DB where the image expects it (AAFTF_DB),
    // the NCBI taxdump for taxonkit (FCS_GX phylum resolution), and /dev/shm
    // (staging). Binding these is harmless for steps that don't use them.
    runOptions = "--bind ${params.aaftf_db}:/opt/aaaftf_db,${params.taxondb}:${params.taxondb},/dev/shm:/dev/shm"
}

process {

    // Resolve the container once for every process: dock://... if docker engine,
    // else the cached SIF (auto-detected). Keeps the modules clean of engine logic.
    container = params.container_engine == 'docker' ? "docker://${params.aaftf_docker}" : params.aaftf_sif

    // ── Default AAFTF resource tier: the core assembly work ─────────
    // Container + NON-login shell (see header note). Retry escalates onto
    // highmem for the steps that genuinely need it (SPAdes, polish, fcsgx).
    withLabel: 'aaftf' {
        shell     = ['/bin/bash']          // NOT -l: preserve the image PATH
        cpus      = 16
        memory    = '64 GB'
        time      = '48h'
        queue     = 'epyc'
        errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
        maxRetries    = 2
        memory = { task.attempt == 1 ? '64 GB' : '128 GB' }
    }

    // ── Light steps: QC / trim / filter against reference DBs ───────
    // `short` partition has a 2 HOUR cap — keep time at 2h. Trim+filter of one
    // sample is easily under this; if it overruns, retry-escalation below bumps
    // it to epyc rather than requesting 12h here (which SLURM rejects).
    withLabel: 'aaftf_trim' {
        shell     = ['/bin/bash']
        cpus      = 8
        memory    = '32 GB'
        errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
        maxRetries    = 2
        time  = { task.attempt == 1 ? '2h' : '48h' }
        queue = { task.attempt == 1 ? 'short' : 'epyc' }
    }

    // ── Vector-screening / tiny steps ───────────────────────────────
    withLabel: 'aaftf_lite' {
        shell     = ['/bin/bash']
        cpus      = 4
        memory    = '16 GB'
        time      = '2h'
        queue     = 'short'
    }

    // ── FCS-GX (optional): huge DB staged to /dev/shm, big memory ───
    withName: 'FCS_GX' {
        errorStrategy = 'retry'
        maxRetries    = 2
        cpus          = 24
        memory        = '450 GB'
        time          = '24h'
        queue         = 'highmem'
        clusterOptions = '-N 1 -n 1'
    }

    // ── SPAdes assemble: the one step that can need more memory ─────
    withName: 'ASSEMBLE' {
        errorStrategy = 'retry'
        maxRetries    = 2
        cpus          = 16
        memory        = { task.attempt == 1 ? '64 GB' : '192 GB' }
        time          = '48h'
        queue         = 'epyc'
    }

    // ── Polish: polca also wants memory + threads ───────────────────
    withName: 'POLISH' {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        queue  = 'epyc'
    }
}

// ── Trace / report / timeline (scoped to this pipeline) ─────────────────────
trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/aaftf_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report   { enabled = true; file = "${launchDir}/logs/nextflow/aaftf_report.html";   overwrite = true }
timeline { enabled = true; file = "${launchDir}/logs/nextflow/aaftf_timeline.html"; overwrite = true }
