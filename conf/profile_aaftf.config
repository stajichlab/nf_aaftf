/*
 * Per-pipeline profile: AAFTF assembly framework (SPAdes short-read + polishing).
 *
 * Owns: this pipeline's params, per-process resources, workDir, and
 * trace/report/timeline so it never collides with other pipelines.
 *
 * Partitions (verify with `sinfo`):
 *   epyc (default,30d) | stajichlab (lab,30d) | short (≤2h) | highmem (30d)
 *
 * Container-only design:
 *   - singularity enabled here; every process carries `container` via withLabel
 *     'aaftf' (TRUE) or 'aaftf_lite' (vector-screening / light steps).
 *   - The AAFTF image hardcodes AAFTF_DB=/opt/aaftf_db, so the host reference
 *     DB is bind-mounted there: singularity.runOptions below. The FCS-GX
 *     database (optional fcs-gx step) is separate and staged into /dev/shm by
 *     the FCS_GX process itself; it also needs extra binds (see runOptions).
 *   - `shell = ['/bin/bash']` (NOT -l): login shell resets PATH on this cluster
 *     and hides the image's pixi env where `AAFTF` lives.
 */

params {
    // ── Inputs / outputs ────────────────────────────────────────────
    indir  = "${launchDir}/input"
    outdir = "${launchDir}/results"
    samples = "${launchDir}/samples.csv"
    n_test  = 0

    // ── Container + reference databases ─────────────────────────────
    // One pipeline, two engines. Set container_engine to pick which one:
    //   'singularity' (default) -> uses the cached SIF (params.aaftf_sif)
    //   'docker'               -> uses the Docker Hub image (docker://params.aaftf_docker)
    // Both refer to the same AAFTF build (ghcr.io/stajichlab/aaftf:main, commit ccd6c26). The
    // SIF was pulled from that Docker image and cached under a versioned name.
    container_engine = 'singularity'          // 'singularity' | 'docker'
    // Versioned SIF built from ghcr.io/stajichlab/aaftf:main at commit ccd6c26 (AAFTF 0.7.0-beta.4-27+gccd6c26).
    // AAFTF.sif still points at the pre-0.7 image, which does not accept this pipeline's command line.
    // After the 0.7 release, use the AAFTF-<tag>.sif attached to the GitHub release.
    aaftf_sif        = "/bigdata/stajichlab/shared/lib/singularity_cache/AAFTF-main-ccd6c26.sif"   // AAFTF 0.7.0-beta.4-27+gccd6c26 (adds depth MITO flag); pin until a stable 0.7.0 release
    aaftf_docker     = "ghcr.io/stajichlab/aaftf:main"   // :latest is the pre-0.7 image until 0.7 is released
    // taxonkit image for TAXON_PHYLUM (the AAFTF >= 0.7 image no longer ships taxonkit).
    // Tag matches taxonkit 0.20.0 in the AAFTF pixi.lock.
    taxonkit_container = "docker://quay.io/biocontainers/taxonkit:0.20.0--h9ee0642_1"
    // AAFTF >= main (ccd6c26) keeps its own contamination database (contamdb.fa + BLAST files) in this
    // folder. Default: a project-local folder in the launch directory (about 5 MB). Build it once with
    //   nextflow run <pipeline> -profile aaftf --setup_db true
    // The folder is bound at /opt/aaftf_db and is the write folder for AAFTF.
    aaftf_db         = "${launchDir}/db"
    taxondb          = "/srv/projects/db/taxonomy"                  // host NCBI taxdump for taxonkit (FCS_GX phylum resolution)
    fcsgx_db         = "/srv/projects/db/ncbi-fcs/0.5.4/gxdb"       // FCS-GX db (host path)
    fcsgx_tmp        = "/dev/shm/gxdb"                              // staged copy seen by the tools

    // ── Pipeline control ────────────────────────────────────────────
    fcs_taxid        = 4751               // fallback NCBI taxonomy id for FCS-GX purge (4751 = Fungi); per-sample override via samples.csv taxid column
    contam_clean_batch_size = 100          // genomes per CONTAM_CLEAN_BATCH job (amortizes ~465GB FCS-GX DB staging); 0 = one job per genome (CONTAM_CLEAN)
    // STAGE TOOL CHOICES — the key knobs of the pipeline. Every one maps to an
    // AAFTF --method and is validated at the CLI: AAFTF <stage> --help.
    assembler        = 'spades'     // spades | megahit | unicycler
    reuse_asm        = ''           // comma-separated samples: take <outdir>/asm/<sample>.<assembler>.fasta instead of re-running ASSEMBLE
    assembler_args   = null         // extra CLI args to the assembler (e.g. megahit t/k-mer, spades k-mers); '' = none
    polisher         = 'polca'      // polca | pypolca | polypolish | nextpolish2 | racon
    skip_fcsgx       = true         // FCS-GX purge is OPTIONAL (big download, big mem)
    skip_vecscreen   = false        // VecScreen (AAFTF vecscreen) on assembled contigs

    // ── Screening stages ────────────────────────────────────────────
    // Two complementary screening categories, both optional:
    //
    // 1) Vector / primer screening (pick one):
    //    vecscreen — BLASTN against UniVec + contaminant DBs (default)
    //    fcs_screen — NCBI FCS adaptor screening (alternative)
    //
    // 2) Contamination screening (run either, both, or neither):
    //    fcs_gx — NCBI FCS-GX taxonomy-based purge (skip_fcsgx=false to enable)
    //    sourpurge — sourmash k-mer LCA purge (skip_sourpurge=false to enable)
    vector_screen_method = 'fcs_screen'  // fcs_screen (default) | vecscreen
    skip_sourpurge = true                // sourmash purge OFF by default
    fcs_screen_prok = false              // fcs_screen: --euk (default) or --prok
    fcs_adaptor_sif = "/bigdata/stajichlab/shared/lib/AAFTF_DB/fcs-adaptor.0.5.5.sif"  // NCBI fcs-adaptor image (FCS_SCREEN runs it directly via apptainer, not through AAFTF's wrapper)

    // ── Trim / filter best practices ────────────────────────────────
    // Primary trimmer is configurable: fastp (default — dedup + merge + 3'
    // quality cut) or trimmomatic (uses the trimmomatic_* knobs below). Pass 2
    // is always bbduk for a second adaptor/quality sweep (JGI-style QC; the
    // interleaved-feed workaround is needed for the BBMap PairStreamer bug).
    // This mirrors JGI-style BBDuk-first QC thinking while staying inside
    // AAFTF's wrapper.
    dedup         = true
    minlen        = 75
    PHRED         = 20              // fastp --cut_right quality cutoff (via avgqual)
    trim_memory   = 8               // GB for bbduk -Xmx (trim pass)
    trim_method1  = 'fastp'         // primary QC/adaptor trim: fastp | trimmomatic
    trim_method2  = 'bbduk'         // second adaptor pass
    // Trimmomatic tuning (used only when trim_method1='trimmomatic'). Defaults
    // are TruSeq3-PE with common leading/trailing/sliding window rules.
    trimmomatic_adaptors      = 'TruSeq3-PE.fa'
    trimmomatic_clip          = '2:30:10'   // ILLUMINACLIP:seed:mismatches:palindromeClipThreshold:simpleClipThreshold
    trimmomatic_leadingwindow = '3'         // LEADING:quality
    trimmomatic_trailingwindow = '3'        // TRAILING:quality
    trimmomatic_slidingwindow = '4:15'      // SLIDINGWINDOW:windowSize:requiredQuality
    trimmomatic_quality       = '15'        // AVGQUAL (kept from AAFTF default)
    filter_aligner = 'bbduk'     // read filter aligner: bbduk | bowtie2 | bwa | minimap2

    // ── Assembly / polishing / finish ───────────────────────────────
    spades_memory = 64            // GB for SPAdes
    polisher_iterations = 1       // AAFTF polish --iterations (polca ignores)
    min_contig_len = 2000         // AAFTF sort/rmdup min contig length
    run_depth    = true           // AAFTF depth (needs reads back-mapped)

    // ── Organelle contig removal, before RMDUP ──────────────────────
    // ORGANELLE maps the filtered reads to the contamination-cleaned assembly with AAFTF depth
    // and removes contigs flagged MITO (high depth AND AT-rich) that match mitochondrial genomes; with
    // skip_plastid = false it also removes high-depth contigs that match plastid genomes. Depth OUTLIER
    // contigs that are not removed are reported as warnings. Needs an AAFTF image with the MITO flag
    // (AAFTF main commit 0904010 or later); aaftf_sif above is pinned to such an image. skip_mitochondrion = true bypasses.
    skip_mitochondrion = false
    skip_plastid       = true     // plastid (chloroplast) removal is off by default; needs the plastid database (see README)
    mito_fold      = 5            // MITO: min depth as a multiple of the nuclear baseline
    mito_gc_drop   = 10           // MITO: min GC drop below the assembly GC (percentage points)
    mito_min_len   = 1000         // MITO: min contig length (bp)
    // Validation of candidates: whole-contig coverage (union of alignments / contig length) against
    // RefSeq organelle genomes. Only candidate contigs are searched, so NUMT/NUPT fragments inside
    // nuclear contigs cannot trigger removal. Build the DBs once with bin/download_organelle_db.sh.
    organelle_db         = "/bigdata/stajichlab/shared/lib/AAFTF_DB/organelle"   // <db>/mitochondrion/, <db>/rdna/, optional <db>/plastid/
    mitochondrion_require_hit = true  // true: remove a MITO candidate only if validated; false: remove all MITO candidates
    rdna_veto_cov        = 0.2    // never remove a contig that is >= this fraction rDNA (NCBI fungal + eukaryote 18S/SSU, 28S/LSU, ITS); 0 disables the veto
    plastid_min_fold     = 10     // plastid candidates: contigs at >= this many times the nuclear baseline depth (lower it for low-copy plastids, e.g. a lichen photobiont)
    plastid_min_cov      = 0.4    // min fraction of a plastid candidate covered by plastid alignments (provisional)
    mito_min_cov         = 0.7    // min fraction of the contig covered by mitochondrial alignments (provisional: 0.5 let a chloroplast contig through; needs more testing)
    organelle_min_pident = 80     // min % identity of an alignment counted toward coverage
}

workDir = "${launchDir}/work/aaftf"

// ── Container engine: enabled + binds the reference DB into the image ───────
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
    // Bind the host AAFTF reference DB where the image expects it (AAFTF_DB),
    // the NCBI taxdump for taxonkit (FCS_GX phylum resolution), and /dev/shm
    // (staging), and the FCS-GX DB so CONTAM_CLEAN* can rsync-stage it.
    // Binding these is harmless for steps that don't use them.
    runOptions = "--bind ${params.aaftf_db}:/opt/aaftf_db,${params.taxondb}:${params.taxondb},${params.fcsgx_db}:${params.fcsgx_db},/bigdata:/bigdata,/scratch:/scratch,/dev/shm:/dev/shm"
}

process {

    // Resolve the container once for every process: dock://... if docker engine,
    // else the cached SIF (auto-detected). Keeps the modules clean of engine logic.
    container = params.container_engine == 'docker' ? "docker://${params.aaftf_docker}" : params.aaftf_sif

    // ── Default AAFTF resource tier: the core assembly work ─────────
    // Container + NON-login shell (see header note). Retry escalates onto
    // highmem for the steps that genuinely need it (SPAdes, polish, fcsgx).
    withLabel: 'aaftf' {
        shell     = ['/bin/bash']          // NOT -l: preserve the image PATH
        cpus      = 16
        memory    = '64 GB'
        time      = '48h'
        queue     = 'epyc'
        errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
        maxRetries    = 2
        memory = { task.attempt == 1 ? '64 GB' : '128 GB' }
    }

    // ── Light steps: QC / trim / filter against reference DBs ───────
    // `short` partition has a 2 HOUR cap — keep time at 2h. Trim+filter of one
    // sample is easily under this; if it overruns, retry-escalation below bumps
    // it to epyc rather than requesting 12h here (which SLURM rejects).
    withLabel: 'aaftf_trim' {
        shell     = ['/bin/bash']
        cpus      = 8
        memory    = { 32.GB * task.attempt }      // 32 / 64 / 96 GB: a retry with the same memory would fail the same way
        errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
        maxRetries    = 2
        time  = { task.attempt == 1 ? '2h' : '48h' }
        queue = { task.attempt == 1 ? 'short' : 'epyc' }
    }

    // ── One-time setup (SETUP_DB entry): a few MB of downloads, run on the head node ──
    withName: 'BUILD_CONTAMDB' {
        executor = 'local'
        cpus     = 1          // the local executor refuses a task that wants more CPUs than the shell has
        memory   = '2 GB'
    }

    // ── taxonkit phylum lookup: tiny, own container ─────────────────
    withLabel: 'taxonkit' {
        container = params.taxonkit_container
        shell     = ['/bin/bash']
        cpus      = 1
        memory    = '2 GB'
        time      = '30m'
        queue     = 'short'
    }

    // ── Vector-screening / tiny steps ───────────────────────────────
    withLabel: 'aaftf_lite' {
        shell     = ['/bin/bash']
        cpus      = 4
        memory    = '16 GB'
        time      = '2h'
        queue     = 'short'
    }

    // ── Native (non-containerized) steps: FCS_SCREEN ────────────────
    // FCS_SCREEN calls apptainer directly against the cached fcs-adaptor
    // SIF (see FCS_SCREEN/main.nf) instead of going through AAFTF's own
    // fcs_screen wrapper, which launches a nested singularity/apptainer
    // container of its own — nested containers don't work from inside our
    // AAFTF SIF. So this process runs uncontainerized on the host; the
    // script sources /etc/profile.d/modules.sh itself to get `module`.
    withLabel: 'aaftf_native' {
        container = false
        shell     = ['/bin/bash']
        cpus      = 4
        memory    = '16 GB'
        time      = '2h'
        queue     = 'short'
    }

    // ── FCS-GX / CONTAM_CLEAN (optional): huge DB staged to /dev/shm ──
    withName: 'CONTAM_CLEAN' {
        errorStrategy = 'retry'
        maxRetries    = 2
        cpus          = 24
        // 466 GB DB (all.gxi 300G + all.gxs 166G); bumped from 450GB->500GB so
        // the SLURM/cgroup memory cap doesn't cut off page-cache residency
        // below the DB's actual size (was causing GX's own "detected
        // page-faults (disk-thrashing)" warning; confirmed 2026-09-26).
        memory        = '500 GB'
        time          = '24h'
        queue         = 'highmem'
        clusterOptions = '-N 1 -n 1'
    }

    // Same resource tier as CONTAM_CLEAN, but longer walltime: one job now
    // covers up to contam_clean_batch_size genomes run sequentially after
    // the one-time DB stage. A retry re-stages the DB and reruns the batch,
    // but already-cleaned genomes (fixed-path skip check) cost only an ls.
    withName: 'CONTAM_CLEAN_BATCH' {
        errorStrategy = 'retry'
        maxRetries    = 2
        cpus          = 24
        // See CONTAM_CLEAN above: 500GB gives the 466GB DB headroom to stay
        // fully page-cache-resident under the job's cgroup memory limit.
        memory        = '500 GB'
        time          = '72h'
        queue         = 'highmem'
        clusterOptions = '-N 1 -n 1'
    }

    // ── SPAdes assemble: the one step that can need more memory ─────
    withName: 'ASSEMBLE' {
        errorStrategy = 'retry'
        maxRetries    = 2
        cpus          = 16
        memory        = { task.attempt == 1 ? '64 GB' : '192 GB' }
        time          = '48h'
        queue         = 'epyc'
    }

    // ── RMDUP: duplicate-contig removal, actually lightweight ────────
    // Was inheriting the generic 'aaftf' label's 64GB default. Measured
    // peak_rss from completed tasks in this project (Nextflow trace,
    // 2026-09-26): ~170-210 MB for ~20-60 MB fungal assemblies -- ~300x
    // less than 64GB. That over-request was blocking concurrency under the
    // stajichlab/epyc association's group memory cap (AssocGrpMemLimit),
    // serializing what should run in parallel. 8GB keeps ~40x headroom
    // over measured usage; retries escalate for any input this hasn't been
    // measured against (e.g. a much larger, non-fungal genome).
    withName: 'RMDUP' {
        errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
        maxRetries    = 2
        cpus          = 16
        memory        = { task.attempt == 1 ? '8 GB' : task.attempt == 2 ? '32 GB' : '64 GB' }
        time          = '48h'
        queue         = 'epyc'
    }

    // ── Polish: polca also wants memory + threads ───────────────────
    withName: 'POLISH' {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        queue  = 'epyc'
    }
}

// ── Trace / report / timeline (scoped to this pipeline) ─────────────────────
trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/aaftf_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report   { enabled = true; file = "${launchDir}/logs/nextflow/aaftf_report.html";   overwrite = true }
timeline { enabled = true; file = "${launchDir}/logs/nextflow/aaftf_timeline.html"; overwrite = true }
