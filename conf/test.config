/*
 * Test / stub profile.  Run with:
 *   nextflow run main.nf -profile test -stub-run --n_test 2
 *
 * Goal: exercise channel/graph wiring fast, with tiny resources, local
 * executor, and stubs that never launch real tools.
 */

params {
    samples   = "${projectDir}/tests/data/test_samples.csv"
    indir     = "${projectDir}/tests/data/input"
    outdir    = "${projectDir}/tests/output"
    n_test    = 2
    aaftf_sif = "/bigdata/stajichlab/shared/lib/singularity_cache/AAFTF.sif"
    container_engine = 'singularity'

    // Mirrors of the pipeline-control params (avoid "undefined parameter" WARNs)
    skip_fcsgx     = true
    skip_vecscreen = false
    run_depth      = true
    dedup          = true
    minlen         = 75
    PHRED          = 20
    trim_memory    = 8
    trim_method1   = 'fastp'
    trim_method2   = 'bbduk'
    filter_aligner = 'bbduk'
    assembler      = 'spades'
    assembler_args = null
    polisher       = 'polca'
    spades_memory  = 64
    min_contig_len = 2000
    polisher_iterations = 1
    aaftf_db       = '/bigdata/stajichlab/shared/lib/AAFTF_DB'
    taxondb        = '/srv/projects/db/taxonomy'
    fcsgx_db       = '/srv/projects/db/ncbi-fcs/0.5.4/gxdb'
    fcs_taxid      = 4751
}

workDir = "${projectDir}/tests/work"

singularity {
    enabled = false
}

process {
    executor = 'local'
    withLabel: 'aaftf'      { cpus = 1; memory = '1 GB'; time = '10m'; beforeScript = ':' }
    withLabel: 'aaftf_trim' { cpus = 1; memory = '1 GB'; time = '10m'; beforeScript = ':' }
    withLabel: 'aaftf_lite' { cpus = 1; memory = '1 GB'; time = '10m'; beforeScript = ':' }
    withName: 'ASSEMBLE'    { cpus = 1; memory = '1 GB'; time = '10m'; beforeScript = ':' }
    withName: 'POLISH'      { cpus = 1; memory = '1 GB'; time = '10m'; beforeScript = ':' }
    withName: 'FCS_GX'      { cpus = 1; memory = '1 GB'; time = '10m'; beforeScript = ':' }
}
