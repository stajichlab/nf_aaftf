/*
 * Root Nextflow config for the AAFTF assembly framework (UCR HPCC / SLURM).
 *
 * Layering:
 *   - This file: manifest, shared SLURM executor, process DEFAULTS, container
 *     engine, and the profiles{} map.
 *   - conf/profile_aaftf.config: the pipeline's params, per-process resources,
 *     its own workDir, and its own trace/report/timeline.
 *   - conf/test.config: minimal profile for -stub-run.
 *
 * Activate:  -profile aaftf
 * Validate:  -profile aaftf -stub-run --n_test 2
 *
 * Notes on the "container-only" design:
 *   - Every process runs with `container = params.aaftf_sif` (the AAFTF
 *     Singularity image pulled from ghcr.io/stajichlab/aaftf:latest). No host
 *     modules are loaded inside processes.
 *   - The image bakes ENV AAFTF_DB=/opt/aaftf_db; the host reference DB is
 *     bind-mounted there via singularity.runOptions (see conf/profile_aaftf).
 *   - AAFTF is reached via the image's baked PATH (/opt/AAFTF/.pixi/envs/...).
 *     A NON-login shell is required for containerized processes: the `-l`
 *     login shell resets PATH from /etc/profile on this cluster and drops the
 *     pixi env bin, so `AAFTF` becomes "command not found". See withLabel
 *     'aaftf' in the profile.
 */

manifest {
    name            = 'nf_aaftf'
    description     = 'AAFTF genome assembly and cleanup (SPAdes short-read, container-only)'
    version         = '0.5.0'
    nextflowVersion = '>=25.10'
}

// ── Shared params (pipeline-specific params live in conf/profile_*.config) ──
// The per-stage *tool-choice* params are the key knobs. Options:
//   parametrisation choices across the pipeline:
//     assembler     = 'spades'     | 'megahit' | 'unicycler' | 'dipspades'
//     trim_method1  = 'fastp'      | 'trimmomatic'   (primary QC/adaptor trim)
//     trim_method2  = 'bbduk'      (second adaptor pass)
//     polisher      = 'polca'      | 'pilon' | 'racon' | 'nextpolish'
//     filter_aligner= 'bbduk'      | 'bowtie2' | 'bwa' | 'minimap2'
//     vector_screen_method = 'vecscreen' | 'fcs_screen'  (vector/primer screen)
//     skip_vecscreen = false       (skip vector screening entirely)
//     skip_fcsgx     = true        (skip NCBI FCS-GX contamination purge)
//     skip_sourpurge = true        (skip sourmash-based contamination purge)
// See conf/profile_aaftf.config for full defaults + documentation.
params {
    samples = "${launchDir}/samples.csv"
    n_test  = 0     // >0 limits the run to the first N samples (handy for testing)
    assembler     = 'spades'       // spades | megahit | unicycler | dipspades
    trim_method1  = 'fastp'        // fastp | trimmomatic
    trim_method2  = 'bbduk'        // second adaptor pass (fixed bbduk workaround)
    polisher      = 'polca'        // polca | pilon | racon | nextpolish
    filter_aligner= 'bbduk'        // bbduk | bowtie2 | bwa | minimap2
    vector_screen_method = 'fcs_screen'  // fcs_screen (default) | vecscreen
    skip_vecscreen = false          // skip vector/primer screening entirely
    skip_fcsgx     = true           // skip NCBI FCS-GX contamination purge
    skip_sourpurge = true           // skip sourmash-based contamination purge
}

// ── SLURM executor (shared by all profiles) ─────────────────────────────────
executor {
    name            = 'slurm'
    queueSize       = 400
    submitRateLimit = '30/1min'
    pollInterval    = '1 min'
    exitReadTimeout = '30 min'
}

// ── Process defaults (apply to every process unless overridden) ──────────────
process {
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    cache          = 'lenient'
    clusterOptions = '-N 1 -n 1'
    queue          = 'epyc'
    // NOTE: no global `shell = ['/bin/bash','-l']` here — containerized AAFTF
    // processes must run in a NON-login shell (login shell resets PATH and
    // hides the image's pixi env). Set shell per-label in the profile.
}

// ── Container engine (all AAFTF processes run inside the SIF) ───────────────
singularity {
    enabled     = false   // flipped true in the aaftf / stub profiles
    autoMounts  = true
    cacheDir    = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
}

// ── Profiles ────────────────────────────────────────────────────────────────
profiles {
    aaftf { includeConfig 'conf/profile_aaftf.config' }
    test  { includeConfig 'conf/test.config'          }
    stub {
        includeConfig 'conf/test.config'
        params.n_test = 2
    }
}
